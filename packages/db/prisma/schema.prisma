generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  HOST
  SUPERHOST
  TRAVEL_ADMIN
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum NotificationType {
  LIKE
  COMMENT
  TAG
  MENTION
  ROOM_INVITE
  SYSTEM
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  phoneNumber       String?
  passwordHash      String
  name              String
  profilePhoto      String?
  bio               String?
  hometown          String?
  role              Role               @default(GUEST)
  themePreference   ThemePreference    @default(SYSTEM)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  verification      VerificationBadge?
  listings          Listing[]
  bookings          Booking[]
  posts             Post[]
  tags              Tag[]
  comments          Comment[]
  likes             Like[]
  receivedBuddyTags TravelBuddyTag[]
  wallet            Wallet?
  referredBookings  Booking[]          @relation("ReferredBookings")
  storyHighlights   StoryHighlight[]
  conversations     Conversation[]     @relation("ConversationParticipants")
  messages          Message[]

  notificationPrefs     NotificationPreference?
  receivedNotifications Notification[]          @relation("ReceivedNotifications")
  sentNotifications     Notification[]          @relation("SentNotifications")

  createdGroupRooms GroupRoom[]       @relation("CreatedGroupRooms")
  groupMemberships  GroupRoomMember[]
  groupMessages     GroupMessage[]

  guideProfile  GuideProfile?
  guideBookings GuideHireBooking[] @relation("TravelerBookings")

  rentalItems    RentalItem[]    @relation("HostRentalItems")
  rentalBookings RentalBooking[] @relation("TravelerRentalBookings")

  givenMentorshipSessions    SuperhostMentorshipSession[] @relation("SuperhostSessions")
  receivedMentorshipSessions SuperhostMentorshipSession[] @relation("AspiringHostSessions")

  corporateMemberships CorporateEmployee[]

  sponsoredCampaigns SponsoredCampaign[]
  adInteractions     AdInteraction[]
}

model VerificationBadge {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isGovtIdVerified Boolean @default(false)
  isEmailVerified  Boolean @default(false)
  isPhoneVerified  Boolean @default(false)
  badgeType        String? // e.g. "VERIFIED_TRAVELER", "SUPERHOST"
}

enum ListingType {
  MONASTERY
  ASHRAM
  HOSTEL
  WORK_STUDIO
  TENT
  MANSION
  LOCAL_ROOM
}

model Listing {
  id                 String                                @id @default(uuid())
  hostId             String
  host               User                                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title              String
  description        String
  type               ListingType
  pricePerNight      Decimal
  address            String
  latitude           Float
  longitude          Float
  location           Unsupported("geometry(Point, 4326)")?
  maxGuests          Int
  bedCount           Int                                   @default(1)
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  amenities          Amenity[]
  customOptions      CustomTripOption?
  bookings           Booking[]
  tags               Tag[]
  rentalItems        RentalItem[]
  sponsoredCampaigns SponsoredCampaign[]
}

model Amenity {
  id       String    @id @default(uuid())
  name     String
  iconKey  String?
  listings Listing[]
}

model CustomTripOption {
  id              String  @id @default(uuid())
  listingId       String  @unique
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hasCabRental    Boolean @default(false)
  hasLocalAttire  Boolean @default(false)
  hasFoodCuration Boolean @default(false)
  hasLocalGuide   Boolean @default(false)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checkIn        DateTime
  checkOut       DateTime
  totalPrice     Decimal
  status         BookingStatus   @default(PENDING)
  createdAt      DateTime        @default(now())
  addOns         AddOn[]
  transaction    Transaction?
  referrerId     String?
  referrer       User?           @relation("ReferredBookings", fields: [referrerId], references: [id], onDelete: SetNull)
  rentalBookings RentalBooking[]

  isCorporateBooking Boolean           @default(false)
  corporateAccountId String?
  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
}

model AddOn {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String // e.g., "CAB", "ATTIRE", "FOOD_CURATION", "GUIDE"
  price     Decimal
}

model Transaction {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider  String // e.g., "RAZORPAY", "PHONEPE", "STRIPE"
  paymentId String?
  status    String // e.g., "SUCCESS", "FAILED", "PENDING"
}

enum PostType {
  PHOTO
  REEL
  MINI_BLOG
}

model Post {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PostType
  title           String?
  content         String?          @db.Text
  mediaUrls       String[]
  createdAt       DateTime         @default(now())
  tags            Tag[]
  comments        Comment[]
  likes           Like[]
  travelBuddyTags TravelBuddyTag[]
}

model Tag {
  id              String   @id @default(uuid())
  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedListingId String?
  taggedListing   Listing? @relation(fields: [taggedListingId], references: [id], onDelete: SetNull)
  taggedGuideId   String? // No Guide model defined yet
  taggedUserId    String?
  taggedUser      User?    @relation(fields: [taggedUserId], references: [id], onDelete: SetNull)
  timestamp       Float? // Second in the video reel where this tag appears
  inlinePosition  Int? // Paragraph index in the mini-blog where this tag is attached
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

enum TravelBuddyStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TravelBuddyTag {
  id           String            @id @default(uuid())
  postId       String
  post         Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUserId String
  taggedUser   User              @relation(fields: [taggedUserId], references: [id], onDelete: Cascade)
  status       TravelBuddyStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([postId, taggedUserId])
}

enum WalletTransactionType {
  COMMISSION
  PAYOUT
  CREDIT
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0)
  currency     String              @default("INR")
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                 String                @id @default(uuid())
  walletId           String
  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount             Decimal
  type               WalletTransactionType
  referenceBookingId String?
  createdAt          DateTime              @default(now())
}

model StoryHighlight {
  id            String   @id @default(uuid())
  hostId        String
  host          User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  coverImageUrl String
  mediaUrls     String[]
  createdAt     DateTime @default(now())
}

model Conversation {
  id           String    @id @default(uuid())
  participants User[]    @relation("ConversationParticipants")
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  mediaUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

enum GroupRoomRole {
  ADMIN
  MEMBER
}

model GroupRoom {
  id         String            @id @default(uuid())
  name       String
  creatorId  String
  creator    User              @relation("CreatedGroupRooms", fields: [creatorId], references: [id], onDelete: Cascade)
  coverImage String?
  createdAt  DateTime          @default(now())
  members    GroupRoomMember[]
  messages   GroupMessage[]
}

model GroupRoomMember {
  id       String        @id @default(uuid())
  roomId   String
  room     GroupRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRoomRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  @@unique([roomId, userId])
}

model GroupMessage {
  id        String    @id @default(uuid())
  roomId    String
  room      GroupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  mediaUrl  String?
  createdAt DateTime  @default(now())
}

model GuideProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyRate      Decimal            @default(0)
  dailyRate       Decimal            @default(0)
  languages       String[]
  specialties     String[]
  serviceAreas    String[]
  experienceYears Int                @default(0)
  rating          Float              @default(0)
  isVerified      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bookings        GuideHireBooking[] @relation("GuideBookings")
}

enum GuideBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model GuideHireBooking {
  id            String             @id @default(uuid())
  guideId       String
  guide         GuideProfile       @relation("GuideBookings", fields: [guideId], references: [id], onDelete: Cascade)
  travelerId    String
  traveler      User               @relation("TravelerBookings", fields: [travelerId], references: [id], onDelete: Cascade)
  date          DateTime
  durationHours Int
  totalAmount   Decimal
  status        GuideBookingStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum RentalCategory {
  VEHICLE_CAB
  VEHICLE_BIKE
  CULTURAL_ATTIRE
}

model RentalItem {
  id             String          @id @default(uuid())
  hostId         String
  host           User            @relation("HostRentalItems", fields: [hostId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  locality       String
  category       RentalCategory
  title          String
  description    String
  pricePerDay    Decimal
  imageUrls      String[]
  sizesAvailable String[] // specific to CULTURAL_ATTIRE
  isAvailable    Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       RentalBooking[]
}

enum RentalBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model RentalBooking {
  id            String              @id @default(uuid())
  rentalItemId  String
  rentalItem    RentalItem          @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  travelerId    String
  traveler      User                @relation("TravelerRentalBookings", fields: [travelerId], references: [id], onDelete: Cascade)
  stayBookingId String?
  stayBooking   Booking?            @relation(fields: [stayBookingId], references: [id], onDelete: SetNull)
  startDate     DateTime
  endDate       DateTime
  selectedSize  String? // specific to CULTURAL_ATTIRE bookings
  totalPrice    Decimal
  status        RentalBookingStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum MentorshipTopic {
  LISTING_PREP
  PRICING_STRATEGY
  HOSPITALITY_TIPS
}

enum MentorshipStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model SuperhostMentorshipSession {
  id             String           @id @default(uuid())
  superhostId    String
  superhost      User             @relation("SuperhostSessions", fields: [superhostId], references: [id], onDelete: Cascade)
  aspiringHostId String
  aspiringHost   User             @relation("AspiringHostSessions", fields: [aspiringHostId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  topic          MentorshipTopic
  status         MentorshipStatus @default(SCHEDULED)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum CorporateRole {
  ADMIN
  EMPLOYEE
}

model CorporateAccount {
  id            String                  @id @default(uuid())
  companyName   String
  billingEmail  String
  gstinTaxId    String?
  creditLimit   Decimal                 @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  employees     CorporateEmployee[]
  bookingPolicy CorporateBookingPolicy?
  bookings      Booking[]
}

model CorporateEmployee {
  id                   String           @id @default(uuid())
  corporateAccountId   String
  corporateAccount     CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  spendingLimitPerTrip Decimal?
  role                 CorporateRole    @default(EMPLOYEE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([corporateAccountId, userId])
}

model CorporateBookingPolicy {
  id                 String           @id @default(uuid())
  corporateAccountId String           @unique
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  maxNightlyRate     Decimal
  allowedStayTypes   ListingType[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum CampaignType {
  SEARCH_BOOST
  SOCIAL_FEED_AD
  BANNER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  DEPLETED
}

model SponsoredCampaign {
  id           String          @id @default(uuid())
  advertiserId String
  advertiser   User            @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  campaignType CampaignType
  budget       Decimal
  spent        Decimal         @default(0)
  cpcRate      Decimal
  impressions  Int             @default(0)
  clicks       Int             @default(0)
  status       CampaignStatus  @default(ACTIVE)
  startDate    DateTime        @default(now())
  endDate      DateTime?
  interactions AdInteraction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum InteractionType {
  IMPRESSION
  CLICK
}

model AdInteraction {
  id              String            @id @default(uuid())
  campaignId      String
  campaign        SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  interactionType InteractionType
  createdAt       DateTime          @default(now())
}

model NotificationPreference {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pauseAllUntil       DateTime?
  likesComments       Boolean   @default(true)
  followersTags       Boolean   @default(true)
  messagesCalls       Boolean   @default(true)
  marketingPromotions Boolean   @default(true)
  securityAlerts      Boolean   @default(true) // Should rarely be false, but included for completeness
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("SentNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  referenceId String? // ID of the post, comment, etc.
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}
