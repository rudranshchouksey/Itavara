generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  HOST
  SUPERHOST
  TRAVEL_ADMIN
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  phoneNumber  String?
  passwordHash String
  name         String
  profilePhoto String?
  bio          String?
  hometown     String?
  role         Role               @default(GUEST)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  verification VerificationBadge?
  listings     Listing[]
  bookings     Booking[]
}

model VerificationBadge {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isGovtIdVerified Boolean @default(false)
  isEmailVerified  Boolean @default(false)
  isPhoneVerified  Boolean @default(false)
  badgeType        String? // e.g. "VERIFIED_TRAVELER", "SUPERHOST"
}

enum ListingType {
  MONASTERY
  ASHRAM
  HOSTEL
  WORK_STUDIO
  TENT
  MANSION
  LOCAL_ROOM
}

model Listing {
  id            String             @id @default(uuid())
  hostId        String
  host          User               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  description   String
  type          ListingType
  pricePerNight Decimal
  address       String
  latitude      Float
  longitude     Float
  maxGuests     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  amenities     Amenity[]
  customOptions CustomTripOption?
  bookings      Booking[]
}

model Amenity {
  id       String    @id @default(uuid())
  name     String
  iconKey  String?
  listings Listing[]
}

model CustomTripOption {
  id              String   @id @default(uuid())
  listingId       String   @unique
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hasCabRental    Boolean  @default(false)
  hasLocalAttire  Boolean  @default(false)
  hasFoodCuration Boolean  @default(false)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Decimal
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  addOns     AddOn[]
  transaction Transaction?
}

model AddOn {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String   // e.g., "CAB", "ATTIRE", "FOOD_CURATION", "GUIDE"
  price     Decimal
}

model Transaction {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider  String   // e.g., "RAZORPAY", "PHONEPE", "STRIPE"
  paymentId String?
  status    String   // e.g., "SUCCESS", "FAILED", "PENDING"
}
