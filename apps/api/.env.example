PORT=4000
NODE_ENV=development
# For Prisma connection pooling, add ?connection_limit=20&pool_timeout=10
DATABASE_URL="postgresql://user:password@localhost:5432/itvara?connection_limit=20&pool_timeout=10"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your_jwt_secret"
JWT_REFRESH_SECRET="your_refresh_secret"
CLIENT_WEB_URL="http://localhost:3000"
CLIENT_MOBILE_SCHEME="itvara://"
STORAGE_BUCKET_URL="http://localhost:9000/itvara-local"
SOCKET_CORS_ORIGIN="http://localhost:3000"

# Phase 41-45 Secrets
TOTP_ENCRYPTION_SECRET=your-secret
AD_CLICK_SIGNING_KEY=your-signing-key
NOTIFICATION_BATCH_LIMIT=100
SESSION_TTL_DAYS=7

